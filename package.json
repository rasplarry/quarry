{
  "name": "quarry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "packageManager": "bun@1.3.10",
  "description": "Local-first database UI with Postgres, SSH tunneling, SQL execution, and OpenAI-assisted SQL generation.",
  "scripts": {
    "dev": "bun run build:ts && node build/server.js",
    "start": "bun run build:ts && node build/server.js",
    "desktop": "bun run build:ts && electron .",
    "typecheck": "tsc --noEmit",
    "build:web": "bun build public/app.ts --target=browser --format=esm --outfile=build/app.js",
    "build:server": "bun build src/server.ts --target=node --format=esm --outfile=build/server.js --external pg --external ssh2",
    "build:ts": "bun run typecheck && bun run build:web && bun run build:server",
    "make:icon": "node scripts/create-icon.mjs",
    "dist:mac": "bun run build:ts && bun run make:icon && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "electron": "30.5.1",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.rasplarry.quarry",
    "productName": "Quarry",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "assets/icon-source.png",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": "-"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
